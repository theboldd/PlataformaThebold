{
  "name": "the-bold-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "THE BOLD — Operating System. Plataforma operacional interna da agência.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch --no-warnings=ExperimentalWarning server/index.js\" \"vite --config web/vite.config.js\"",
    "build": "vite build --config web/vite.config.js",
    "start": "node --no-warnings=ExperimentalWarning server/index.js",
    "seed": "node --no-warnings=ExperimentalWarning server/seed.js",
    "test": "node --no-warnings=ExperimentalWarning --test server/tests/*.test.js",
    "migrar:notion": "node --no-warnings=ExperimentalWarning server/migration/import-notion.js",
    "base:real": "BOLD_SEED=equipe node --no-warnings=ExperimentalWarning server/seed.js && npm run migrar:notion && npm run migrar:quadros && npm run acessos:clientes && npm run migrar:cr-editorial && npm run revisar:herdados",
    "migrar:quadros": "node --no-warnings=ExperimentalWarning server/migration/import-notion-quadro.js outubro && node --no-warnings=ExperimentalWarning server/migration/import-notion-quadro.js novembro",
    "acessos:clientes": "node --no-warnings=ExperimentalWarning server/migration/client-access.js",
    "revisar:herdados": "node --no-warnings server/migration/revisar-herdados.js",
    "migrar:cr-editorial": "node --no-warnings server/migration/import-cr-editorial.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "playwright": "1.56",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.4"
  }
}
